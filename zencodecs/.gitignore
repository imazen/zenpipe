Cargo.lock
# Commit the fuzz crate's lockfile (standalone cargo-fuzz needs a pre-existing
# lock; it does not auto-generate one on `cargo fuzz build`). Matches the
# convention in sibling fuzz crates (e.g. zenwebp) and the global fuzzing rule.
!fuzz/Cargo.lock
.claude/worktrees/

# === Standard exclusions (do not depend on user ~/.gitignore) ===

# Rust build artifacts
target/

# Fuzz build artifacts and crashes
fuzz/target/
fuzz/artifacts/
fuzz/corpus/
fuzz/coverage/
fuzz/.external-cache/
fuzz-*.log
*.profraw
*.profdata

# Profiling
perf.data
perf.data.old
flamegraph.svg
heaptrack.*.zst
cachegrind.out.*
callgrind.out.*
massif.out.*

# C/C++ build artifacts
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.rlib

# Compiled binaries with no extension
rust_out

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# Editors
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# Tooling noise
.superwork/
copter-report/
.zenbench/
Cargo.toml.original.txt
*.rs.local
